<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>发布信息 - 校园失物招领</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="header"><div class="nav">
  <div class="logo"><a href="/">校园失物招领</a></div>
  <div class="nav-links">
    <a href="/">首页</a><a href="/user-center">个人中心</a>
    <span style="color:rgba(255,255,255,0.7);font-size:13px;">欢迎，<%= user.username %></span>
    <a href="/logout" class="btn-logout">退出</a>
  </div>
</div></div>
<div class="container">
  <div class="card">
    <h2 style="color:#667eea;margin-bottom:20px;">发布信息</h2>
    <form action="/publish" method="post" enctype="multipart/form-data">
      <div class="form-group"><label>信息类型</label><select name="type" required><option value="">请选择类型</option><option value="lost">失物招领</option><option value="found">寻物启事</option></select></div>
      <div class="form-group"><label>标题</label><input type="text" name="title" placeholder="请输入标题" required></div>
      <div class="form-group"><label>详细描述</label><textarea name="content" placeholder="请详细描述物品特征、丢失/捡到地点等信息" required></textarea></div>
      <div class="form-group"><label>联系方式</label><input type="text" name="contact" placeholder="QQ/微信/电话等" required></div>
      <div class="form-group"><label>上传图片（可选）</label><input type="file" name="image" accept="image/*"></div>
      <div class="form-group"><button type="submit" class="btn-submit">发 布</button></div>
    </form>
  </div>
</div>
<div class="footer">&copy; 2026 校园失物招领系统</div>
</body>
</html>
