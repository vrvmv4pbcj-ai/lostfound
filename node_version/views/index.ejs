<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>校园失物招领系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="header"><div class="nav">
  <div class="logo"><a href="/">校园失物招领</a></div>
  <div class="nav-links">
    <a href="/publish">发布信息</a>
    <a href="/user-center">个人中心</a>
    <span style="color:rgba(255,255,255,0.7);font-size:13px;">欢迎，<%= user.username %></span>
    <a href="/logout" class="btn-logout">退出</a>
  </div>
</div></div>

<div class="container">
  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <form class="search-bar" action="/" method="get">
    <input type="text" name="keyword" placeholder="搜索标题或描述..." value="<%= keyword %>">
    <select name="type">
      <option value="">全部类型</option>
      <option value="lost" <%= type==='lost'?'selected':'' %>>失物招领</option>
      <option value="found" <%= type==='found'?'selected':'' %>>寻物启事</option>
    </select>
    <button type="submit" class="btn-search">搜索</button>
  </form>

  <a href="/publish" class="btn-publish">+ 发布信息</a>

  <div class="card">
    <% if (list.length === 0) { %><p style="text-align:center;color:#999;padding:40px 0;">暂无相关信息</p><% } %>
    <% list.forEach(function(post) { %>
      <div class="post-item">
        <div class="post-info">
          <a href="/detail/<%= post.id %>" class="post-title">
            <span class="post-type <%= post.type==='lost'?'type-lost':'type-found' %>"><%= post.type==='lost'?'失物':'寻物' %></span>
            <%= post.title %>
          </a>
          <div class="post-meta">发布者：<%= post.username %> | 发布时间：<%= post.createTime %></div>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (page > 1) { %><a href="/?page=<%= page-1 %>&type=<%= type %>&keyword=<%= keyword %>">上一页</a><% } %>
    <% for (var p = 1; p <= totalPages; p++) { %>
      <% if (p === page) { %><span class="current"><%= p %></span><% } else { %>
        <a href="/?page=<%= p %>&type=<%= type %>&keyword=<%= keyword %>"><%= p %></a>
      <% } %>
    <% } %>
    <% if (page < totalPages) { %><a href="/?page=<%= page+1 %>&type=<%= type %>&keyword=<%= keyword %>">下一页</a><% } %>
  </div>
  <% } %>
</div>
<div class="footer">&copy; 2026 校园失物招领系统 - 课程设计项目</div>
</body>
</html>
